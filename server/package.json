{
  "name": "@termrail/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run check",
    "test": "npm run build && node scripts/config-model.test.cjs && node scripts/pty-backend.test.cjs && node scripts/windows-console-input.test.cjs && node scripts/session-operation-queue.test.cjs && node scripts/session-manager.test.cjs && node scripts/ws.test.cjs",
    "smoke": "npm run build && node scripts/smoke.cjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@termrail/shared": "file:../shared",
    "@xterm/addon-serialize": "0.13.0",
    "@xterm/headless": "5.5.0",
    "express": "^4.19.2",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
